{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pin Notes",
  "version": "1.0.0",
  "identifier": "com.pinnotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "id": "main-tray"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OUM3QjcyQzI4QTczQ0IKUldUTGM0ckNjbnVjS1lZaTlTdUkxNThuc2ZGcEZ1TlYyeUM4cXpVbVNGcmxoZVJGdll2NEMzcncK",
      "endpoints": [
        "https://github.com/AleenaTahir1/Pin-Notes/releases/latest/download/latest.json"
      ]
    }
  }
}
